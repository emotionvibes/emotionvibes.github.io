---
import {render,slugs} from '../render.js';import questions from '../data/questions.json';import thoughts from '../data/thoughts.json';import site from '../data/site.json';import '../style.css';
export function getStaticPaths(){return ['ru','lt'].flatMap(lang=>[...slugs.map(page=>({params:{path:lang+(page?'/'+page:'')},props:{lang,page,detail:''}})),...['questions','thoughts'].flatMap(page=>(page==='questions'?questions:thoughts).map(x=>({params:{path:`${lang}/${page}/${x.slug}`},props:{lang,page,detail:x.slug}})))]);}
const {lang,page,detail}=Astro.props;const title=(detail?(page==='questions'?questions:thoughts).find(x=>x.slug===detail)?.[lang].title:site[lang].nav[slugs.indexOf(page)]||site[lang].privacy)+' | EmotionVibes';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={site[lang].intro}/><title>{title}</title><link rel="alternate" hreflang="ru" href={`https://emotionvibes.github.io/ru/${page}${page?'/':''}${detail?detail+'/':''}`}/><link rel="alternate" hreflang="lt" href={`https://emotionvibes.github.io/lt/${page}${page?'/':''}${detail?detail+'/':''}`}/></head><body><Fragment set:html={render(lang,page,detail)}/><script>import {activate} from '../render.js';activate(document.documentElement.lang);</script></body></html>
